# AIPMS Frontend Environment Variables

# Public API Gateway URL (used by browser clients for API requests)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Internal API Gateway URL (used by Next.js server rewrites in Docker container or SSR)
INTERNAL_API_URL=http://api-gateway:3000

# Managed Supabase Project Configuration (anon public key only - do NOT use service_role here)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
