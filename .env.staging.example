# =============================================================================
# AIPMS Isolated Staging Environment Configuration (Placeholders Only)
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# =============================================================================

# Staging Environment Mode
NODE_ENV=staging
PORT=3000

# Client Application Origins (CORS Allowed Origins, comma-separated)
CORS_ORIGIN=https://aipms-staging.vercel.app,http://localhost:3008

# Isolated Staging Supabase Project Settings
# Sourced from your dedicated staging Supabase project dashboard (Settings > API)
SUPABASE_URL=https://<staging-project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...<staging-anon-key-placeholder>
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...<staging-service-role-key-placeholder>

# Microservice Local Inter-Service Routing (Inside Render Consolidated Container)
AUTH_SERVICE_URL=http://127.0.0.1:3001
PROJECT_SERVICE_URL=http://127.0.0.1:3002
TEAM_SERVICE_URL=http://127.0.0.1:3003
TASK_SERVICE_URL=http://127.0.0.1:3004
SPRINT_SERVICE_URL=http://127.0.0.1:3005
RISK_SERVICE_URL=http://127.0.0.1:3006
REPORTING_SERVICE_URL=http://127.0.0.1:3007
AI_SERVICE_URL=http://127.0.0.1:3009

# Local AI / Ollama Staging Options
# Option A (Free/Heuristic): Leave empty to run deterministic heuristic analysis without GPU host
OLLAMA_BASE_URL=
# Option B (Dedicated GPU Staging Host): https://ollama-staging.yourdomain.com
OLLAMA_TIMEOUT_MS=30000

# Concurrency & Memory Constraints
UV_THREADPOOL_SIZE=2
