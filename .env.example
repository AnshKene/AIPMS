# ==============================================================================
# AIPMS (AI-Based Project Management System) - Environment Configuration
# ==============================================================================
# Copy this template to .env before starting Docker Compose:
#   cp .env.example .env
#
# Replace the placeholders below with your actual managed Supabase credentials.
# Do NOT commit real secrets or credentials into version control.
# ==============================================================================

# ─── Managed Supabase Configuration ──────────────────────────────────────────
# Required by backend microservices and frontend authentication.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# ─── Port Bindings (Host Machine) ─────────────────────────────────────────────
# Ports exposed on host machine for local development and access.
GATEWAY_PORT=3000
FRONTEND_PORT=3008

# ─── Frontend Client API URL ──────────────────────────────────────────────────
# Public endpoint accessed by the user's browser (points to API Gateway).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ─── Local Ollama Integration (AI Microservice) ───────────────────────────────
# When running Ollama natively on the host, host.docker.internal routes from
# inside the container to the host daemon on port 11434.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=30000
